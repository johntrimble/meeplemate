#!/usr/bin/env bash
set -e  # Exit immediately if a command exits with non-zero status

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
DOT_ENV_FILE="$PROJECT_ROOT/.env"
DOT_ENV_EXAMPLE_FILE="$PROJECT_ROOT/.env.example"
# Devcontainer-only settings (MY_UID, MY_GID, POSTGRES_PASSWORD) live next to
# compose.yaml so the .devcontainer/ directory is self-contained.
DEVCONTAINER_ENV_FILE="$PROJECT_ROOT/.devcontainer/.env"
DEVCONTAINER_ENV_EXAMPLE_FILE="$PROJECT_ROOT/.devcontainer/.env.example"

# Error handling function
error_exit() {
    echo "ERROR: $1" >&2
    exit 1
}

set_env_value() {
    local env_file="$1"
    local key="$2"
    local value="$3"

    if grep -q "^${key}=" "$env_file"; then
        local temp_file
        temp_file=$(mktemp "${env_file}.XXXXXX") || error_exit "Failed to create temporary env file"
        awk -v key="$key" -v value="$value" '
            index($0, key "=") == 1 { print key "=" value; next }
            { print }
        ' "$env_file" > "$temp_file" || error_exit "Failed to update $key in $env_file"
        mv "$temp_file" "$env_file" || error_exit "Failed to replace $env_file"
    else
        echo "${key}=${value}" >> "$env_file" || error_exit "Failed to add $key to $env_file"
    fi
    echo "$key set in $env_file"
}

# Check for required tools
command -v docker >/dev/null 2>&1 || error_exit "Docker is not installed. Please install Docker first."
command -v docker compose >/dev/null 2>&1 || error_exit "Docker Compose is not installed. Please install Docker Compose first."

# Ensure docker compose is at least version 2.24.0
DOCKER_COMPOSE_VERSION=$(docker compose version --short 2>/dev/null || echo "0.0.0")
REQUIRED_VERSION="2.24.0"
if [[ "$(printf '%s\n' "$REQUIRED_VERSION" "$DOCKER_COMPOSE_VERSION" | sort -V | tail -n1)" != "$DOCKER_COMPOSE_VERSION" ]]; then
    error_exit "Docker Compose version must be at least $REQUIRED_VERSION. Current version: $DOCKER_COMPOSE_VERSION. Please update Docker Compose."
fi

# Create the .env files if they don't already exist
if [ ! -f "$DOT_ENV_FILE" ]; then
    echo "Creating .env file from $DOT_ENV_EXAMPLE_FILE"
    cp "$DOT_ENV_EXAMPLE_FILE" "$DOT_ENV_FILE" || error_exit "Failed to create .env file"
fi
if [ ! -f "$DEVCONTAINER_ENV_FILE" ]; then
    echo "Creating .env file from $DEVCONTAINER_ENV_EXAMPLE_FILE"
    cp "$DEVCONTAINER_ENV_EXAMPLE_FILE" "$DEVCONTAINER_ENV_FILE" || error_exit "Failed to create .devcontainer/.env file"
fi

# Keep mounted-volume ownership aligned with the host on both macOS and Linux.
set_env_value "$DEVCONTAINER_ENV_FILE" "MY_UID" "$(id -u)"
set_env_value "$DEVCONTAINER_ENV_FILE" "MY_GID" "$(id -g)"

# Create data and .cache directories if they do not exist
mkdir -p "$PROJECT_ROOT/data" || error_exit "Failed to create data directory"
mkdir -p "$PROJECT_ROOT/data/.cache" || error_exit "Failed to create cache directory"
