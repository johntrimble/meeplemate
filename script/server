#!/usr/bin/env bash

# Check running in dev container
if [ ! -f /.dockerenv ]; then
    echo "error: this script must be run from inside the dev container" >&2
    exit 1
fi

cleanup() {
    echo ""
    echo "Stopping servers..."
    kill "$api_pid" "$frontend_pid" 2>/dev/null
    wait "$api_pid" "$frontend_pid" 2>/dev/null
}
trap cleanup EXIT INT TERM

# Start the api server (and ensure it stops when the script exits)
uvicorn meeplemate.server.api:create_app --factory --host 0.0.0.0 --port 8000 --reload --reload-dir /workspace/meeplemate &
api_pid=$!

# Start the frontend (and ensure it stops when the script exits)
(cd /workspace/frontend && npm run dev) &
frontend_pid=$!

echo "API server running (PID $api_pid) on http://localhost:8000"
echo "Frontend running (PID $frontend_pid) on http://localhost:5173"
# Only report the simulation as ON when the value is a positive number, matching
# when the Vite plugin actually enables it (so "0" / non-numeric don't mislead).
if [[ "$VITE_SIMULATE_COLD_START" =~ ^[0-9]+$ ]] && [ "$VITE_SIMULATE_COLD_START" -gt 0 ]; then
    echo "Cold-start simulation ON: /api/* returns 500 for the first ${VITE_SIMULATE_COLD_START}s (unset VITE_SIMULATE_COLD_START to disable)"
fi
# Same guard as above: only claim the delay is on when the plugin will enable it.
if [[ "$VITE_SIMULATE_STREAM_DELAY" =~ ^[0-9]+$ ]] && [ "$VITE_SIMULATE_STREAM_DELAY" -gt 0 ]; then
    echo "Stream delay ON: each send waits ${VITE_SIMULATE_STREAM_DELAY}s before the backend streams (unset VITE_SIMULATE_STREAM_DELAY to disable)"
fi
echo "Press Ctrl+C to stop."

wait
