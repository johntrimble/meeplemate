{
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/.venv/**": true,
        "reference_repositories/**": true,
        "data/**": true,
        "**/.mypy_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/__pycache__/**": true
    },
    "notebook.output.wordWrap": true,
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.exclude": [
        "**/.*",
        "**/node_modules",
        "**/__pycache__",
        ".git",
        "reference_repositories/**",
        "data/**"
    ],
    "python.analysis.packageIndexDepths": [
        { "name": "langchain", "depth": 5 },
        { "name": "langchain_core", "depth": 5 },
        { "name": "langchain_classic", "depth": 5 },
        { "name": "langgraph", "depth": 5 },
    ]
}
