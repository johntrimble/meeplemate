{
  // Name for the dev container, which appears in the VS Code UI.
  "name": "Meeplemate",

  // Points to the Docker Compose file that defines the services.
  "dockerComposeFile": "../compose.yaml",

  // The service within the Docker Compose file to use for the dev container.
  "service": "dev",

  // The folder to open in the container.
  "workspaceFolder": "/workspace",

  // VS Code specific customizations.
  // Disable SSH agent forwarding so the container cannot use host SSH keys.
  "remoteEnv": {
    "SSH_AUTH_SOCK": ""
  },

  // Re-apply machine-scope VS Code settings on every container start.
  // Settings an extension declares as "scope": "machine" are ignored by VS Code
  // when they appear in .vscode/settings.json, so they only take effect in the
  // container's own store at ~/.vscode-server/data/Machine/settings.json --
  // which is recreated from scratch whenever .vscode-server is rebuilt.
  "postStartCommand": "python3 ${containerWorkspaceFolder}/script/configure_vscode_machine_settings.py",

  "customizations": {
    "vscode": {
      // Default settings for VS Code inside the container.
      "settings": {
        // Sets the default Python interpreter to the one in the virtual
        // environment. This virtual environment is created by entrypoint.sh.
        "python.defaultInterpreterPath": "${containerEnv:VENV_PATH}/bin/python"
      },
      // Extensions to install in VS Code inside the container.
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "github.copilot",
        "anthropic.claude-code",
        "bircni.compress-preview",
        "mechatroner.rainbow-csv"
      ]
    }
  }
}
