#!/usr/bin/env bash
# Apply this project's Claude Code preferences to the user settings in the
# container.
#
# ~/.claude is a named volume mounted over the image, so this has to run per
# container rather than at build time. Settings are merged into whatever is
# already there, so it is safe to re-run and leaves hooks, permissions and
# other user settings alone.
#
# Usage: .devcontainer/script/claude-setup
set -euo pipefail

settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"

# No Claude attribution trailer on commits or footer on pull requests.
preferences='{"attribution": {"commit": "", "pr": ""}}'

mkdir -p "$(dirname "$settings")"
[ -s "$settings" ] || echo '{}' > "$settings"

tmp="$(mktemp "$settings.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
jq --argjson preferences "$preferences" '. * $preferences' "$settings" > "$tmp"
cat "$tmp" > "$settings"

echo "claude: preferences applied to $settings"
