# Docker Compose uses these values to run the development stack. The bootstrap
# script replaces MY_UID and MY_GID with the current host user's values.
MY_UID=1000
MY_GID=1000
POSTGRES_PASSWORD=password

# Load the checked-in local-development configuration. The embedding API key is
# required by the settings schema but is not used by the local FastEmbed model.
MM_CONFIG_FILE=config-dev.yaml
MM_EMBEDDING__API_KEY=not-needed

# The local stack works without a Firebase project. Remove these flags and
# configure Firebase credentials when testing the real sign-in flow.
MM_AUTH_BYPASS=true
VITE_AUTH_BYPASS=true
