# Hindsight agent memory. Copy this file to .env.hindsight and fill it in:
#
#   cp .env.hindsight.example .env.hindsight
#   chmod 600 .env.hindsight
#
# The dev container loads this file into the dev service's environment (see
# .devcontainer/compose.yaml), which is the whole of Hindsight's configuration —
# no config file is written. The bank id is fixed to `meeplemate` in compose.yaml,
# so any HINDSIGHT_BANK_ID here is ignored. Do not commit it.
HINDSIGHT_API_URL=
HINDSIGHT_API_TOKEN=
