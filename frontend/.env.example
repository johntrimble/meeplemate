# frontend/.env.example
# Copy relevant vars to frontend/.env.local (never commit .env.local)

# =============================================================================
# FIREBASE (real auth — required when VITE_AUTH_BYPASS is not set)
# =============================================================================

# VITE_FIREBASE_API_KEY=AIzaSyCCFjdtLHqsepm5_TZw0KIjTM4tdkcMAgQ
# VITE_FIREBASE_AUTH_DOMAIN=boardbarian.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=boardbarian

# =============================================================================
# AUTH BYPASS (local dev / testing only — never set in production)
# =============================================================================

# Set to "true" to skip Firebase entirely and use VITE_AUTH_BYPASS_USER.
# VITE_AUTH_BYPASS=true
# VITE_AUTH_BYPASS_USER={"uid":"local-dev","email":"dev@local","name":"Dev User"}

# =============================================================================
# FIREBASE EMULATOR (testing only — connects to local firebase-emulator service)
# =============================================================================

# Set to "true" to connect the Firebase SDK to the local Auth Emulator.
# Replaces the Google OAuth popup with an email/password form.
VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=firebase-emulator:9099
VITE_FIREBASE_API_KEY=fake-api-key
