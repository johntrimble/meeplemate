# syntax=docker/dockerfile:1
# docker/Dockerfile.api
# Production image for the MeepleMate FastAPI backend.
# Embedding model and tokenizer are baked in for fast cold-start on Azure Container Apps.

ARG PYTHON_VERSION=3.12
ARG FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
ARG TOKENIZER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
ARG SOPS_VERSION=3.13.3
# sha256 of sops-v${SOPS_VERSION}.linux.amd64, from the release's checksums.txt
ARG SOPS_SHA256=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b

# -- Stage 1: builder ----------------------------------------------------------
FROM python:${PYTHON_VERSION} AS builder

ARG PYTHON_VERSION
ARG FASTEMBED_MODEL
ARG TOKENIZER_MODEL

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /uvx /bin/

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_PREFERENCE=only-system

WORKDIR /app
COPY pyproject.toml uv.lock* ./

# Install all production dependencies (project package excluded for now)
RUN uv sync --python /usr/local/bin/python${PYTHON_VERSION} --no-install-project --no-dev

# Pre-download fastembed embedding model (ONNX, CPU-only)
ENV FASTEMBED_CACHE_PATH=/opt/fastembed_cache
RUN /opt/venv/bin/python -c \
    "from fastembed import TextEmbedding; list(TextEmbedding(model_name='${FASTEMBED_MODEL}', cache_dir='/opt/fastembed_cache').embed(['warmup']))"

# Pre-download HuggingFace tokenizer (config/vocab files only, no model weights)
ENV HF_HOME=/opt/hf_cache
RUN /opt/venv/bin/python -c \
    "from tokenizers import Tokenizer; Tokenizer.from_pretrained('${TOKENIZER_MODEL}')"

# Copy source and install the meeplemate package itself
COPY . .
RUN uv sync --python /usr/local/bin/python${PYTHON_VERSION} --no-dev

# Strip sympy, pulled in by onnxruntime as an optional shape-inference dep,
# not needed for inference at serving time.
RUN uv pip uninstall --python /opt/venv/bin/python sympy


# -- Stage 2: runtime ---------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim

ARG SOPS_VERSION
ARG SOPS_SHA256

# sops decrypts runtime credentials in the entrypoint. The build fails if the
# download doesn't match the pinned checksum.
ADD --checksum=sha256:${SOPS_SHA256} --chmod=0755 \
    https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-v${SOPS_VERSION}.linux.amd64 \
    /usr/local/bin/sops
COPY --chmod=0755 docker/api-entrypoint.sh /usr/local/bin/api-entrypoint

# Venv with pre-compiled bytecode
COPY --from=builder /opt/venv /opt/venv

# Pre-baked model caches
COPY --from=builder /opt/fastembed_cache /opt/fastembed_cache
COPY --from=builder /opt/hf_cache /opt/hf_cache

# Project source (needed because the package is installed from source)
COPY --from=builder /app /app

ENV PATH="/opt/venv/bin:$PATH" \
    FASTEMBED_CACHE_PATH=/opt/fastembed_cache \
    HF_HOME=/opt/hf_cache \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1

WORKDIR /app
EXPOSE 8000

# Decrypts MEEPLEMATE_SOPS_ENV into MM_* variables when it's set, then runs CMD;
# see docker/api-entrypoint.sh.
ENTRYPOINT ["api-entrypoint"]

# --no-access-log: Cloud Run already emits a request log for every request, and the
# app emits its own `http.request` record carrying request_id / user_id / chat_id.
# uvicorn's access line would be a third copy with strictly less information.
# No --log-config: logging is configured in-process (meeplemate.logging_config) so
# local dev, tests and prod all share one code path.
CMD ["uvicorn", "meeplemate.server.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
