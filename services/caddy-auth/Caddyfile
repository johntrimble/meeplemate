:8080 {

  # Debug
  handle /__debug* {
    respond "token={http.request.uri.query.token}\n" 200
  }

  # One-time login: requires token, then sets cookie and redirects
  handle /__demo_login* {
    @bad not query token={env.DEMO_TOKEN}
    respond @bad "Missing or invalid token" 401

    header Set-Cookie "demo=1; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=86400"
    redir / 302
  }

  # Everything else requires cookie presence
  @no_cookie not header_regexp hasDemoCookie Cookie (^|;\s*)demo=
  respond @no_cookie "Demo access required. Use the login link." 401

  reverse_proxy 127.0.0.1:8000
}
